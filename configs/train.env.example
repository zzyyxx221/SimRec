# Copy this file outside the repository, fill in the paths, and run:
#   CONFIG_FILE=/path/to/simrec.env bash SimRec/train_simrec.sh

# Required inputs.  Paths are deliberately placeholders; no data, model, or
# credential is included in this repository.
MODEL_NAME=Qwen/Qwen3-4B
TRAIN_DATA=/path/to/train.jsonl
VAL_DATA=/path/to/validation.jsonl
SEARCH_INDEX_DIR=/path/to/catalog-index
SEARCH_MODEL_PATH=Qwen/Qwen3-Embedding-4B

# `external` uses an OpenAI-compatible user simulator. `self_play` has the
# same rollout model generate shopper turns, so it does not use API settings.
SIMREC_USER_SIMULATOR_MODE=external
SIMREC_USER_LLM_BASE_URL=https://api.example.com
SIMREC_USER_LLM_MODEL=your-user-simulator-model
# Export SIMREC_USER_LLM_API_KEY in your shell; never put it in this file.

GPUS=0
N_NODES=1
ROLLOUT_N=4
TRAIN_BATCH_SIZE=4
VAL_BATCH_SIZE=4
PPO_MINI_BATCH_SIZE=4
PPO_MICRO_BATCH_SIZE_PER_GPU=1
LOGPROB_MICRO_BATCH_SIZE_PER_GPU=1
MAX_PROMPT_LENGTH=2048
MAX_RESPONSE_LENGTH=1024
MAX_TURNS=4
TOTAL_TRAINING_STEPS=200
SAVE_FREQ=50
TEST_FREQ=50
GPU_MEMORY_UTILIZATION=0.4

# Search and task-aligned reward.
SIMREC_SEARCH_MODE=dense
SIMREC_FINAL_RETRIEVAL_MODE=dense
SIMREC_RECALL_EXPANSION_MODE=dense
SIMREC_SEARCH_TOP_K=10
SIMREC_VALIDATION_SEARCH_TOP_K=100
SIMREC_SEARCH_DISPLAY_TOP_K=10
SIMREC_TRAIN_INJECT_TARGET_ON_MISS=true
SIMREC_VALIDATION_INJECT_TARGET_ON_MISS=false
SIMREC_MIN_USER_TURNS_BEFORE_TARGET_INJECTION=2
SIMREC_VALID_SEARCH_BONUS=0.03
SIMREC_VALID_ITEM_DETAILS_BONUS=0.01
SIMREC_VALID_USER_PREFERENCE_BONUS=0.0
SIMREC_RETRIEVAL_NDCG_REWARD_SCALE=1.0
SIMREC_HIT_AT_1_REWARD=0.8

WANDB_MODE=offline
